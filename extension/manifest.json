{
  "manifest_version": 3,
  "name": "Chrome-to-Terminal",
  "short_name": "Chrome-to-Terminal",
  "version": "1.0.4",
  "description": "Run selected commands from web pages directly in your terminal, Command Prompt, or PowerShell.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging", "storage", "scripting"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_title": "Chrome-to-Terminal", "default_popup": "popup.html"},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "options_page": "options.html",
  "key": ""
}
